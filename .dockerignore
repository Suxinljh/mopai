# Keep the build context small and, more importantly, keep local state out of
# the image. `.env` never belongs in a layer: the container gets its config from
# docker-compose's `env_file` at run time.

# Installed by the build stage from package-lock.json.
node_modules/
mopai-worker/node_modules/

# Rebuilt inside the image.
dist/

# Local state. `data/` holds the SQLite database — a stale copy baked into the
# image would be silently shadowed by the volume, or worse, shipped elsewhere.
data/
*.db
*.db-journal
*.db-wal

# Secrets and local overrides.
.env
.env.*
!.env.example
mopai-worker/.dev.vars
# The tunnel token. Mounted into the cloudflared container at run time; it must
# never enter the build context, where it could end up in a layer cache.
secrets/

# Version control and editor/agent noise.
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.log

# Documentation, theme sources and verification artifacts: none of it is needed
# to produce dist/. (THEME-SOURCES.md and licenses/ stay in the repo for
# attribution; they do not need to be in the image.)
*.md
verify-out/
licenses/
skills/
scripts/
.github/
