# 公众号排版助手 by Yoru — example environment file.
# Copy to .env and fill in. Never commit the real .env.

# ---- App -------------------------------------------------------------------
NODE_ENV=production
PORT=3100

# Bind address. Under docker-compose no host port is published at all, so the
# app is reachable only across the compose network — but it must still bind
# 0.0.0.0 inside the container for cloudflared to reach it at http://app:3100.
# Running directly on a host instead, 127.0.0.1 keeps the public IP from serving
# the site without going through the tunnel.
HOST=0.0.0.0

# SQLite file. Relative paths resolve against the process working directory.
# docker-compose.yml puts this on a named volume so it survives image rebuilds.
DATABASE_URL=file:./data/mopai.db

# Owner key. Typesetting, copying, exporting and uploading images all work
# without it; logging in is what unlocks the cloud drafts box.
# Generate with: openssl rand -hex 24
ACCESS_KEY=change-me

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# ---- Open uploads ----------------------------------------------------------
# Uploads need no login, so these four bound what a stranger can spend. All are
# optional; the defaults below are what the public instance runs with.
#
# Per visitor — a first-party cookie identifies the browser — over a rolling 24 h:
ANON_DAILY_IMAGES=30
ANON_DAILY_BYTES=104857600
# Every anonymous upload put together; the bucket is a shared free tier:
ANON_TOTAL_BYTES=1610612736
# Per source IP per minute, in memory, to stop a flood before it reaches disk:
ANON_BURST_PER_MINUTE=12

# ---- Image worker ----------------------------------------------------------
# Public base URL of the mopai-images worker. Must match the custom domain on
# its [[routes]] entry in mopai-worker/wrangler.toml — the app builds every
# public image URL from this value.
IMG_BASE_URL=https://img.example.com

# Shared secret with the worker: `wrangler secret put IMG_ADMIN_KEY` in
# mopai-worker/ must be given this exact value, or every upload fails with
# "图床鉴权失败".
# Generate with: openssl rand -hex 32
IMG_ADMIN_KEY=change-me

# ---- Cloudflare Tunnel -----------------------------------------------------
# The tunnel token deliberately does NOT live in this file. docker-compose.yml
# injects every key in .env into the `app` container, and the app is the only
# component that handles untrusted uploads — giving it the tunnel token would
# let a compromise there stand up its own tunnel into this host's network.
#
# Put it in secrets/tunnel-token instead (gitignored); only cloudflared mounts
# it, read-only:
#   mkdir -p secrets
#   printf '%s' '<your tunnel token>' > secrets/tunnel-token
#   chmod 600 secrets/tunnel-token
#
# With the `tunnel` profile enabled, Docker refuses to start if that file is
# missing, so the stack cannot come up silently without a tunnel. A plain
# `docker compose up -d` does not enable that profile and needs no token at all,
# which is how the site is reached at http://<host>:3100 before a domain exists.
#
# Hostname and ingress live in the Zero Trust dashboard, not in this file:
# add a public hostname for your domain pointing at service http://app:3100
# (the compose service name — NOT 127.0.0.1, which is the container itself).

# ---- Agent API -------------------------------------------------------------
# Tokens for /api/agent/*, the door a coding agent uses to push a draft into the
# editor and read the polished article back. Comma-separated name:token pairs,
# with an optional scope suffix (:read for a token that may only read).
#
#   AGENT_TOKENS=claude-code:mopai_aaa…,reviewer:mopai_bbb…:read
#
# One token per agent, so deleting a line revokes that agent alone. The name is
# not secret — it is recorded as `agent:<name>` on every article it pushes.
# Mint one with:
#   python -c "import secrets,base64;print('mopai_'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
#
# Left empty (the default), every /api/agent/* request is refused with 401.
# This is NOT the browser's credential: ACCESS_KEY stays the human login.
#
# If the site sits behind Cloudflare Access, only /api/agent/* may be given a
# service-token bypass. Never /api/trpc/* — that prefix carries auth.login, and
# exposing it would open the access key to brute force from the internet.
AGENT_TOKENS=

# Absolute origin used to build the editorUrl handed back to agents. Optional:
# when unset it is derived from the incoming request, which is already the public
# origin behind a Cloudflare Tunnel. Set it only if something rewrites Host.
PUBLIC_BASE_URL=
